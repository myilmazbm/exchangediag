{
  // Ortam tipi. "lab" secilirse profiles.json'daki skipModules/ignoreFindings uygulanir.
  "profile": "production",

  // "discovery" ANAHTARI KALDIRILDI (auto | manual). Kod tarafinda hic
  // okunmuyordu: M01 her kosumda Get-ExchangeServer'i cagirir ve sonucu
  // yalnizca asagidaki servers/excludeServers ile suzer, yani "manual"
  // yazmak AD sorgusunu ENGELLEMIYORDU. Gercek yapilamaz da: site, surum,
  // rol ve DAG uyeligi yalnizca o cagridan gelir. Ayni niyet icin asagidaki
  // servers listesini kullanin - bos birakmak "otomatik", doldurmak
  // "yalnizca bunlar" demektir.

  // Bos = otomatik kesif. Doluysa SADECE bu sunucular taranir.
  "servers": [],

  // Taranmayacak sunucular (orn. Edge Transport).
  "excludeServers": [],

  // Bos = otomatik tespit (aktif/mounted DB'si olmayan site pasif sayilir).
  // Otomatik tespit yanlis karar veriyorsa site adlarini buraya yazin.
  "passiveSites": [],

  // Tracking log penceresi (saat). Genis pencere pahalidir; kisa tutun,
  // yogun saatte birkac kez calistirip -CompareWith ile karsilastirin.
  "trackingWindowHours": 1,

  // Es zamanli runspace sayisi.
  // UYARI: Exchange throttling policy'sindeki PowerShellMaxConcurrency (varsayilan 18)
  // asilirsa yeni oturumlar reddedilir. Arac bu degeri okur ve tavani otomatik
  // olarak sinirin yarisina ceker; buraya buyuk bir sayi yazmak ise yaramaz.
  "parallelism": 4,

  // "auto"   = once SMB uzerinden ham MSGTRK*.LOG, olmazsa Get-MessageTrackingLog
  // "smb"    = yalnizca ham dosya okuma (20-50x hizli)
  // "cmdlet" = yalnizca cmdlet (admin paylasimlarinin kapali oldugu ortamlar)
  "logAccess": "auto",

  // Bos = otomatik kesif (yerel makine -> AD). Elle vermek icin:
  // "exchangeUri": "http://exchange01.ornek.local/PowerShell/"
  "exchangeUri": "",

  "authentication": "Kerberos",

  // M20/M21: perf sayaci ornekleme. Tek bir tur her iki modulu de besler.
  // Persentil uretebilmek icin birden fazla ornek sarttir; tek okuma tepe
  // anlarini gizler. Sure = perfSampleCount x perfSampleIntervalSeconds ve
  // TUM SUNUCULAR icin ayni anda islediginden sunucu sayisiyla artmaz.
  "perfSampleCount": 20,
  "perfSampleIntervalSeconds": 1,

  // M24: taranacak en fazla posta kutusu. Get-MailboxFolderStatistics her
  // posta kutusu icin ayri ve PAHALI bir cagridir; modul tum ortami taramaz,
  // M23 (agir kullanicilar) ve M12 (yavas teslim alicilari) kanitini takip
  // eder. Kapsam orani her zaman rapora yazilir.
  "maxFolderScans": 50,

  // M12: yavas teslimlerin alicilarini veritabani ile eslerken sorgulanacak
  // en fazla benzersiz alici. Her alici bir Get-Recipient cagrisidir; aramalar
  // en cok gecikme yasayandan baslar ve kapsam orani rapora yazilir.
  "maxRecipientLookups": 300,

  // M23: teshis KAPISI, esik DEGIL (bu yuzden thresholds.json'da degil).
  // Bir posta kutusu icin "BEKLIYOR" / "CPU YAKIYOR" demeden once olcum
  // penceresinde en az bu kadar milisaniye sunucu zamani harcamis olmasi
  // aranir. 3 ms sunucu zamaninin 0 ms CPU'ya orani da sonsuzdur ama kimse
  // beklemiyordur; bu kapi olmadan bos bir sistemde kanit dosyasinin cogu
  // satiri "bulgu" gibi okunuyordu. Satirin OK/WARN/FAIL hukmu buradan
  // DEGIL, thresholds.json -> storeTimeInServerMs'ten gelir.
  // Yukseltmek gercek bulgulari da susturabilir - taban olarak dusunun.
  "storeDiagnosisFloorMs": 1000,

  // KOSUM GENELINDE ZAMAN BUTCESI (dakika). 0 = SINIRSIZ.
  //
  // Butce dolunca kalan moduller HIC BASLATILMAZ; her biri rapora ADIYLA ve
  // "BUTCE BITTI - bu kontrol YAPILMADI" notuyla TIMEOUT satiri olarak duser,
  // kosumun sonuna CORE / Kosum butcesi satiri eklenir ve cikis kodu 0
  // OLAMAZ. Yani kesilen kosum kendini tam kosum gibi SUNMAZ.
  //
  // Neden gerekli: kodca izin verilen en kotu -Heavy kosumu ~3 saat 39 dakika
  // surebiliyor ve onu kesecek hicbir sey yoktu. "Yogun saatte olc" diye
  // 09:00'da baslatilan kosum 12:40'ta bitiyor, rapor ise onu hala yogun saat
  // saniyordu. Varsayilan 60, trackingWindowHours ile ayni buyukluktedir:
  // anlattigi saatten uzun suren bir kosum artik o saati anlatmiyordur.
  //
  // Bu anahtar eski "moduleTimeoutSeconds" ayarinin yerini aldi; o ayar
  // belgeliydi ama kodda HIC OKUNMUYORDU (gercek 120 sn sabit koddan
  // geliyordu) ve modul basina sert bir timeout zaten uygulanamiyor -
  // PowerShell.Stop() yerel kodu kesemez. Uygulanabilir tek sinir bu
  // ISBIRLIKCI son tarihtir; ayni son tarih ham log ayristiricisina da
  // gecirilir.
  //
  // Genis kapsamli bir -Heavy taramasi icin yukseltin (orn. 180) ya da
  // -BudgetMinutes ile tek seferlik ezin.
  "runBudgetMinutes": 60
}
